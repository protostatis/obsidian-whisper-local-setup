+const LOCAL_AUDIO_CHUNK_MS = 5 * 60 * 1e3;
+function isLoopbackWhisperEndpoint(apiUrl) {
+  try {
+    const url = new URL(apiUrl);
+    const host = url.hostname.replace(/^\[|\]$/g, "");
+    return ["localhost", "127.0.0.1", "::1"].includes(host) && /\/v1\/audio\/transcriptions\/?$/.test(url.pathname);
+  } catch {
+    return false;
+  }
+}
+async function getAudioDurationSeconds(blob) {
+  const mediaUrl = URL.createObjectURL(blob);
+  const media = new Audio();
+  media.preload = "metadata";
+  let duration = Number.NaN;
+  try {
+    duration = await new Promise((resolve) => {
+      let timeout;
+      const finish = (value) => {
+        window.clearTimeout(timeout);
+        media.removeEventListener("loadedmetadata", onLoaded);
+        media.removeEventListener("error", onError);
+        resolve(value);
+      };
+      const onLoaded = () => finish(media.duration);
+      const onError = () => finish(Number.NaN);
+      media.addEventListener("loadedmetadata", onLoaded, { once: true });
+      media.addEventListener("error", onError, { once: true });
+      timeout = window.setTimeout(() => finish(Number.NaN), 5e3);
+      media.src = mediaUrl;
+    });
+  } finally {
+    media.removeAttribute("src");
+    media.load();
+    URL.revokeObjectURL(mediaUrl);
+  }
+  if (Number.isFinite(duration) && duration > 0) {
+    return duration;
+  }
+  const AudioContextClass = window.AudioContext || window.webkitAudioContext;
+  if (!AudioContextClass) {
+    throw new Error("This app cannot read the audio duration needed for safe local chunking");
+  }
+  let context;
+  try {
+    context = new AudioContextClass({ sampleRate: 16e3 });
+  } catch {
+    context = new AudioContextClass();
+  }
+  try {
+    const decoded = await context.decodeAudioData(await blob.arrayBuffer());
+    return decoded.duration;
+  } finally {
+    await context.close().catch(() => {
+    });
+  }
+}
